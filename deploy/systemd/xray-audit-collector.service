[Unit]
Description=Xray Audit Collector
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=audituser
Group=audituser
WorkingDirectory=/opt/xray-audit/current
EnvironmentFile=/etc/xray-audit/xray-audit.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/xray-audit/current/venv/bin/xray-audit-collector
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
