[Unit]
Description=Xray Audit API with embedded collector
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=audituser
Group=audituser
WorkingDirectory=/opt/xray-audit/current
EnvironmentFile=/etc/xray-audit/xray-audit.env
Environment=PYTHONUNBUFFERED=1
Environment=AUDIT_COLLECTOR_EMBEDDED=true
ExecStart=/opt/xray-audit/current/venv/bin/xray-audit-api
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xray-audit
ReadOnlyPaths=-/var/log/xray
UMask=0027
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
