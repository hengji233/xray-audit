[Unit]
Description=Legacy Xray Audit AI Error Summary Worker (disabled in v0.2.0)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
ConditionPathExists=/etc/xray-audit/enable-legacy-ai-summary

[Service]
Type=simple
User=audituser
Group=audituser
WorkingDirectory=/opt/xray-audit/current
EnvironmentFile=/etc/xray-audit/xray-audit.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/xray-audit/current/venv/bin/xray-audit-ai-summary
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
